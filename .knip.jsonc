{
  // Package exports, HTML, Vite/Playwright config and package scripts are discovered by Knip.
  // These roots are loaded dynamically by the runtime-test driver and compatibility pool.
  "entry": [
    "src/{runtime,browser,prompt}/*.test.ts",
    "tests/*.unit.ts",
    "tests/helpers/git-consumer.ts",
    "scripts/bash-compat-worker.ts",
    // Filename-discovered scoreboard tests are independent executable roots.
    "scripts/test-{shell-scoreboard*,own-shell-*,bash-compat*,compat-selection}.{mjs,ts}",
    "scripts/waffle-node-api.ts",
    "scripts/waffle-root-worker.ts",
    "scripts/waffle-child-worker.ts",
    "scripts/node-worker-thread.ts",
    // Launched as a detached subprocess by the typed-output regression test.
    "scripts/repro-pipeline-broken-pipe.ts",
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  // Ghostty is a pinned source alias outside our graph. It consumes the hotkeys tarball.
  // The duplicate-check driver spawns the pinned jscpd executable by path.
  "ignoreDependencies": ["ghostty-webgpu", "@fregat/hotkeys", "jscpd"],
  // WASI qualification and CPython's native build require these system tools.
  "ignoreBinaries": ["wasmtime"],
}
