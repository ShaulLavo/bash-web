{
  // Package exports, HTML, Vite/Playwright config and package scripts are discovered by Knip.
  // These roots are loaded dynamically by the runtime-test driver and compatibility pool.
  "entry": ["src/{runtime,browser}/*.test.ts", "tests/*.unit.ts", "scripts/bash-compat-worker.mjs"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  // Ghostty is a pinned source alias outside our graph. It consumes the hotkeys tarball.
  // The duplicate-check driver spawns the pinned jscpd executable by path.
  "ignoreDependencies": ["ghostty-webgpu", "@fregat/hotkeys", "jscpd"],
  // The existing WASI/compatibility gates provision this external executable.
  "ignoreBinaries": ["wasmtime"],
}
