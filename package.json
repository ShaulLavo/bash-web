{
  "name": "bash-web",
  "version": "0.0.114",
  "description": "WASM-first bash-compatible shell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/bash-web.git"
  },
  "files": [
    "dist",
    "!dist/product-shell",
    "shell",
    "scripts",
    "patches",
    "docs",
    "plans",
    "sources.lock.json",
    "README.md",
    "LICENSE",
    "src",
    "third-party"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell.ts",
    "./prompt": "./src/prompt/index.ts",
    "./session": "./src/session.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format:check": "oxfmt --check scripts shell src tests package.json vite.config.ts playwright.config.ts tsconfig*.json .oxlintrc.json .knip.jsonc .unknot.json quality docs/code-quality.md '!scripts/fixtures/**/*.json'",
    "test:rust": "node scripts/ci/check-shell-parser.ts && cargo fmt --manifest-path shell/Cargo.toml --all --check && cargo test --locked --manifest-path shell/Cargo.toml --workspace -j2",
    "build:shell": "node scripts/build/build-shell.ts",
    "build:test-grep": "node scripts/build/build-test-grep.ts",
    "check:capabilities": "node scripts/ci/check-shell-capabilities.ts",
    "test:shell:wasi": "node scripts/ci/test-shell-wasi.ts",
    "test:shell:scoreboard": "npm run build:node-harness && npm run build:test-grep && npm run test:shell:scoreboard:prebuilt",
    "test:shell:scoreboard:prebuilt": "node scripts/scoreboard/scoreboard-tests.ts",
    "compat:shell": "npm run build:node-harness && npm run compat:shell:prebuilt",
    "prepare:shell-corpus": "node scripts/compat/prepare-shell-corpus.ts",
    "fuzz:shell-braces": "node scripts/fuzz-shell-braces.ts",
    "test:fuzz-shell-braces": "node --test scripts/compat/fuzz/test-fuzz-shell-braces.ts",
    "fuzz:shell-substitutions": "node scripts/fuzz-shell-substitution-boundaries.ts",
    "test:fuzz-shell-substitutions": "node --test scripts/compat/fuzz/test-fuzz-shell-substitution-boundaries.ts",
    "fuzz:shell-words": "node scripts/fuzz-shell-words.ts",
    "fuzz:shell-words:ci": "node scripts/fuzz-shell-words.ts --replay scripts/fixtures/shell-words-seed-1.json --replay scripts/fixtures/shell-words-seed-42.json",
    "fuzz:shell-arithmetic": "node scripts/fuzz-shell-arithmetic.ts",
    "fuzz:shell-arithmetic:ci": "node scripts/fuzz-shell-arithmetic.ts --replay scripts/fixtures/shell-arithmetic-seed-7.json --replay scripts/fixtures/shell-arithmetic-seed-314.json",
    "fuzz:shell-readonly": "node scripts/fuzz-shell-readonly.ts",
    "fuzz:shell-readonly:ci": "node scripts/fuzz-shell-readonly.ts --replay scripts/fixtures/shell-readonly-seed-17.json",
    "fuzz:shell-braces:ci": "node scripts/fuzz-shell-braces.ts --replay scripts/fixtures/shell-braces-seed-1.json --replay scripts/fixtures/shell-braces-seed-42.json",
    "fuzz:shell-substitutions:ci": "node scripts/fuzz-shell-substitution-boundaries.ts --replay scripts/fixtures/shell-substitutions-seed-1.json --replay scripts/fixtures/shell-substitutions-seed-42.json",
    "fuzz:shell-parse-boundaries:ci": "node scripts/fuzz-shell-parse-boundaries.ts --replay scripts/fixtures/shell-parse-boundaries.json",
    "notices:shell": "node scripts/build/notices.ts",
    "fuzz:shell-control-flow": "node scripts/fuzz-shell-control-flow.ts",
    "test:fuzz-shell-control-flow": "node --test scripts/compat/fuzz/test-fuzz-shell-control-flow.ts",
    "fuzz:shell-control-flow:ci": "node scripts/fuzz-shell-control-flow.ts --replay scripts/fixtures/shell-control-flow-seed-1.json --replay scripts/fixtures/shell-control-flow-seed-42.json",
    "fuzz:shell-job-lifetime": "node scripts/fuzz-shell-job-lifetime.ts",
    "test:fuzz-shell-job-lifetime": "node --test scripts/compat/fuzz/test-fuzz-shell-job-lifetime.ts",
    "fuzz:shell-job-lifetime:ci": "node scripts/fuzz-shell-job-lifetime.ts --replay scripts/fixtures/shell-job-lifetime-seed-1.json --replay scripts/fixtures/shell-job-lifetime-seed-42.json",
    "fuzz:shell-functions": "node scripts/fuzz-shell-functions.ts",
    "test:fuzz-shell-functions": "node --test scripts/compat/fuzz/test-fuzz-shell-functions.ts",
    "fuzz:shell-functions:ci": "node scripts/fuzz-shell-functions.ts --replay scripts/fixtures/shell-functions-seed-1.json --replay scripts/fixtures/shell-functions-seed-42.json",
    "fuzz:shell-path": "node scripts/fuzz-shell-path.ts",
    "test:fuzz-shell-path": "node --test scripts/compat/fuzz/test-fuzz-shell-path.ts",
    "fuzz:shell-path:ci": "node scripts/fuzz-shell-path.ts --replay scripts/fixtures/shell-path-seed-1.json --replay scripts/fixtures/shell-path-seed-42.json",
    "sources:browser": "node scripts/build/sources.ts",
    "build:shell:browser": "node scripts/build/build-shell-browser.ts",
    "build:browser": "npm run sources:browser && npm run build:worker && npm run build:shell:browser && npm run build:test-guest && npm run build:browser:assets && npm run build:test:product-shell",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "test:browser": "playwright test",
    "test:session": "node --test scripts/browser/test-session.ts",
    "test:start-fresh": "node --test src/browser/start-fresh.test.ts",
    "test:runtime:terminal": "node --expose-gc scripts/browser/test-runtime-terminal.ts",
    "test:terminal:display": "node --test scripts/browser/test-terminal-display.ts",
    "terminal:widths": "node scripts/browser/terminal-widths.ts",
    "notices:browser": "npm run notices:shell && node scripts/build/browser-notices.ts",
    "serve": "node dist/serve.mjs",
    "verify:browser": "npm run test:browser:package && npm run build:browser && npm run typecheck:browser && npm run test:runtime:terminal && npm run test:browser",
    "capture:family-symbols": "node scripts/build/capture-family-symbols.ts",
    "test:installed-waffle": "node --test scripts/build/verification/test-installed-waffle.ts",
    "test:browser:package": "node --test scripts/build/verification/test-browser-package.ts",
    "build:worker": "node scripts/build/build-worker.ts",
    "prepare": "npm run build:worker",
    "version:packages": "changeset version && npm install --package-lock-only && bun install --lockfile-only",
    "test:git:browser": "node scripts/browser/test-git-browser.ts",
    "build:test-guest": "node scripts/build/build-test-guest.ts",
    "fuzz:shell-printf": "node scripts/fuzz-shell-printf.ts",
    "test:fuzz-shell-printf": "node --test scripts/compat/fuzz/test-fuzz-shell-printf.ts",
    "fuzz:shell-printf:ci": "node scripts/fuzz-shell-printf.ts --replay scripts/fixtures/shell-printf-seed-1.json --replay scripts/fixtures/shell-printf-seed-42.json",
    "check:layers": "node scripts/ci/check-layers.ts",
    "test:check-layers": "node --test scripts/ci/test-check-layers.ts",
    "typecheck:layers": "tsc --ignoreConfig --noEmit --strict --target ESNext --module NodeNext --moduleResolution NodeNext --types node --allowImportingTsExtensions scripts/ci/check-layers.ts scripts/ci/test-check-layers.ts",
    "compat": "npm run compat:shell",
    "lint": "node scripts/ci/check-lint.ts && unknot .",
    "typecheck": "node scripts/ci/typecheck-projects.ts",
    "typecheck:prompt-consumer": "tsc -p tests/types/prompt-consumer/tsconfig.json",
    "check:unused": "knip --config .knip.jsonc --treat-config-hints-as-errors",
    "check:duplicates": "node scripts/ci/check-duplicates.ts",
    "check:javascript": "node scripts/ci/check-javascript.ts",
    "check:rust": "node scripts/ci/check-rust-quality.ts",
    "test:quality-gates": "node --test scripts/ci/test-quality-gates.ts",
    "test:family-routes": "node scripts/build-node-harness.ts && node --test scripts/build/verification/test-family-routes.ts",
    "quality": "npm run sources:browser && npm run build:worker && npm run quality:js && npm run check:rust && cargo test --locked --manifest-path shell/Cargo.toml --workspace -j2 --no-fail-fast",
    "build:node-harness": "node scripts/build-node-harness.ts",
    "build:compat-control": "node scripts/build/build-compat-control.ts",
    "test:guest-build": "node --test scripts/build/verification/test-wasi-build.ts scripts/build/verification/test-waffle-release-inputs.ts scripts/build/verification/test-waffle-host-interface.ts scripts/build/verification/test-verify-wasi-guests.ts scripts/build/verification/test-build-compat-control.ts scripts/build/verification/test-wasi-guest-path.ts scripts/build/verification/test-waffle-fixture-lifecycle.ts",
    "typecheck:guest-build": "tsc --ignoreConfig --noEmit --strict --target ESNext --module NodeNext --moduleResolution NodeNext --types node --allowImportingTsExtensions scripts/ci/check-shell-capabilities.ts scripts/wasi-build.ts scripts/build/waffle-release-inputs.ts scripts/build/build-compat-control.ts scripts/build/verification/test-build-compat-control.ts scripts/ci/test-shell-wasi.ts scripts/wasi-build.ts scripts/build/verify-wasi-guests.ts scripts/build/verification/test-verify-wasi-guests.ts scripts/build/wasi-guest-path.ts scripts/build/verification/test-wasi-guest-path.ts scripts/build/waffle-fixture-lifecycle.ts scripts/build/verification/test-waffle-fixture-lifecycle.ts",
    "fuzz:shell-echo": "node scripts/fuzz-shell-echo.ts",
    "test:fuzz-shell-echo": "node --test scripts/compat/fuzz/test-fuzz-shell-echo.ts",
    "fuzz:shell-echo:ci": "node scripts/fuzz-shell-echo.ts --replay scripts/fixtures/shell-echo.json",
    "quality:js": "npm run test:browser:package && npm run test:prompt && npm run test:prompt:size && npm run test:session && npm run test:start-fresh && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:prompt-consumer && npm run check:unused && npm run check:duplicates && npm run check:javascript && npm run test:quality-gates && node --test scripts/build/verification/test-family-routes.ts",
    "build:browser:assets": "npm run notices:browser && npm run bundle:browser:assets",
    "test:ci": "node --test --test-concurrency=1 scripts/ci/test-ci-inputs.ts scripts/ci/test-ci-workflow.ts scripts/build/verification/test-prepare-wasi-tests.ts scripts/ci/test-ci-artifacts.ts scripts/ci/test-ci-notices.ts scripts/scoreboard/test-scoreboard-discovery.ts",
    "prepare:wasi-tests": "node scripts/build/prepare-wasi-tests.ts .build/ci-native/wasi-tests",
    "typecheck:ci": "tsc --ignoreConfig --noEmit --strict --target ESNext --module NodeNext --moduleResolution NodeNext --types node --allowImportingTsExtensions scripts/ci/ci-inputs.ts scripts/ci/ci-artifacts.ts scripts/build/prepare-wasi-tests.ts scripts/ci/test-ci*.ts scripts/build/verification/test-prepare-wasi-tests.ts",
    "compat:shell:prebuilt": "BASH_COMPAT_MODE=frozen BASH_COMPAT_ENGINES=own-shell node scripts/compat/bash-compat.ts",
    "notices:browser:ci": "node scripts/ci/ci-artifacts.ts notices .build/ci-native && node scripts/build/browser-notices.ts",
    "bundle:browser:assets": "vite build && node scripts/build/finish-build.ts",
    "build:browser:assets:ci": "npm run notices:browser:ci && npm run bundle:browser:assets && npm run build:test:product-shell",
    "test:file-substitution": "npm run build:node-harness && node --test scripts/test-own-shell-file-substitution.ts",
    "test:select": "npm run build:node-harness && node --test scripts/test-own-shell-select.ts",
    "test:shell:completion:pending": "npm run build:node-harness && BASH_COMPLETION_PENDING=1 node --test scripts/test-own-shell-completion.ts",
    "test:shell:function-names:pending": "npm run build:node-harness && BASH_FUNCTION_NAMES_PENDING=1 node --test scripts/replay/test-own-shell-function-names.ts",
    "prepare:python:browser": "node scripts/test-own-shell-python.ts --prepare-browser",
    "test:python:browser": "node scripts/test-own-shell-python.ts --browser",
    "test:prompt:size": "node --experimental-strip-types scripts/browser/test-prompt-size.ts",
    "test:prompt": "node scripts/browser/test-prompt.ts",
    "test:prompt:browser": "bun scripts/browser/test-prompt-status-browser.ts",
    "test:ios:adapters": "bun test ./tests/ios/*.unit.ts",
    "test:startup:local": "bun scripts/browser/test-startup-diagnostics-local.ts",
    "build:test:product-shell": "node scripts/build/build-product-shell-test.ts",
    "test:browser:integration": "npm run build:test:product-shell && playwright test tests/product-shell.spec.ts",
    "changeset": "changeset"
  },
  "dependencies": {
    "@waffle/python": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-python-0.0.23.tgz",
    "waffle-base": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-base-0.0.23.tgz",
    "waffle-git": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-git-0.0.23.tgz",
    "waffle-ripgrep": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-ripgrep-0.0.23.tgz"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@fregat/hotkeys": "https://github.com/ShaulLavo/hotkeys/releases/download/hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd/fregat-hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd.tgz",
    "@playwright/test": "1.64.0",
    "@singapore-editor/core": "https://github.com/ShaulLavo/singapore/releases/download/singapore-47d5f77a721ef68572f8f729dac7342230f178cb/singapore-editor-core-0.2.11.tgz",
    "@singapore-editor/textbuffer": "https://github.com/ShaulLavo/singapore/releases/download/singapore-47d5f77a721ef68572f8f729dac7342230f178cb/singapore-editor-textbuffer-0.2.9.tgz",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.3",
    "@webgpu/types": "0.1.74",
    "bash-web-public": "https://github.com/ShaulLavo/bash-web/releases/download/bash-web-v0.0.113/bash-web-0.0.113.tgz",
    "esbuild": "0.28.2",
    "ghostty-public": "https://github.com/ShaulLavo/ghostty-webgpu/releases/download/v0.3.34-feeb78fa9/ghostty-webgpu.tgz",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.88.0",
    "remix": "3.0.0",
    "typescript": "7.0.2",
    "unknot": "0.1.2",
    "vite": "8.3.3",
    "waffle": "npm:@waffle-os/runtime@0.0.156",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "waffle": "*"
  },
  "overrides": {
    "@singapore-editor/textbuffer": "$@singapore-editor/textbuffer",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "waffleHostInterface": 3
}
