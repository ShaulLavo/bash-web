{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ],
    "no-debugger": "error",
    "no-eval": "error",
    "eqeqeq": ["error", "always"],
    "typescript/no-explicit-any": "error",
    "max-depth": ["error", 3],
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "complexity": [
      "error",
      {
        "max": 30,
        "variant": "modified"
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "name",
        "message": "Use a declared local name or explicit window.name; ambient browser name can hide a parameter rename."
      }
    ]
  },
  "overrides": [
    // Frozen-fingerprint fuzzer drivers deferred to plans/008-duplicate-baseline.md — shrink when refactored together with fixture hashes.
    {
      "files": [
        "scripts/fuzz-shell-braces.ts",
        "scripts/fuzz-shell-control-flow.ts",
        "scripts/fuzz-shell-functions.ts",
        "scripts/fuzz-shell-job-lifetime.ts",
        "scripts/fuzz-shell-path.ts",
        "scripts/fuzz-shell-printf.ts",
        "scripts/fuzz-shell-substitution-boundaries.ts"
      ],
      "rules": {
        "no-nested-ternary": "off"
      }
    },
    // Legacy else-after-return in frozen-fingerprint PATH fuzzer driver deferred to plans/008-duplicate-baseline.md.
    {
      "files": ["scripts/fuzz-shell-path.ts"],
      "rules": {
        "no-else-return": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
