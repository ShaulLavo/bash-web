{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node", "@webgpu/types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component",
    "paths": {
      "ghostty-webgpu": ["./.sources/ghostty-webgpu/src/index.ts"]
    },
    "allowJs": true
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts", "scripts/**/*.ts"]
}
